import heapq
from collections import deque
class WaterNetwork:
    def __init__(self):
        self.graph = {}
        self.edges = []
  def add_node(self, node):
        if node not in self.graph:
            self.graph[node] = []
 def add_pipe(self, u, v, cost):
        if cost < 0:
            raise ValueError("Pipe cost cannot be negative.")
 self.add_node(u)
        self.add_node(v)
 self.graph[u].append((v, cost))
        self.graph[v].append((u, cost))
        self.edges.append((cost, u, v))
 def bfs(self, start):
        if start not in self.graph:
            return []
visited = {start}
        queue = deque([start])
        order = []
while queue:
            node = queue.popleft()
            order.append(node)
  for neighbor, cost in self.graph[node]:
                if neighbor not in visited:
                    visited.add(neighbor)
                    queue.append(neighbor)
   return order
def dfs(self, start):
        if start not in self.graph:
            return []
visited = set()
        order = []
def visit(node):
            visited.add(node)
            order.append(node)
for neighbor, cost in self.graph[node]:
                if neighbor not in visited:
                    visit(neighbor)
  visit(start)
        return order
def prim(self, start=None):
        if not self.graph:
            return [], 0
start = start or next(iter(self.graph))
        visited = set()
        result = []
        total = 0
        heap = []
 def add_edges(node):
            visited.add(node)
            for neighbor, cost in self.graph[node]:
                if neighbor not in visited:
                    heapq.heappush(
                        heap, (cost, node, neighbor) )
                     add_edges(start)
  while heap and len(visited) < len(self.graph):
            cost, u, v = heapq.heappop(heap)
if v in visited:
             continue
result.append((u, v, cost))
            total += cost
            add_edges(v)
  if len(visited) != len(self.graph):
 return [], None
return result, total
def kruskal(self):
        parent = {node: node for node in self.graph}
        rank = {node: 0 for node in self.graph}
 def find(node):
            if parent[node] != node:
                parent[node] = find(parent[node])
            return parent[node]
def union(a, b):
            root_a = find(a)
            root_b = find(b)
 if root_a == root_b:
                return False
 if rank[root_a] < rank[root_b]:
                parent[root_a] = root_b
            elif rank[root_a] > rank[root_b]:
                parent[root_b] = root_a
            else:
                parent[root_b] = root_a
                rank[root_a] += 1
 return True
result = []
        total = 0
 for cost, u, v in sorted(self.edges):
            if union(u, v):
                result.append((u, v, cost))
                total += cost

        if len(result) != len(self.graph) - 1:
            return [], None
  return result, total
  def dijkstra(self, start):
        if start not in self.graph:
            return {}
distances = {node: float("inf") for node in self.graph}
        distances[start] = 0
        heap = [(0, start)]
while heap:
            distance, node = heapq.heappop(heap)
if distance != distances[node]:
                continue
for neighbor, cost in self.graph[node]:
                new_distance = distance + cost
if new_distance < distances[neighbor]:
                    distances[neighbor] = new_distance
                    heapq.heappush(
                        heap, (new_distance, neighbor) )
                        return distances

    def bellman_ford(self, start):
        if start not in self.graph:
            return {}, False
distances = {node: float("inf") for node in self.graph}
        distances[start] = 0

        directed_edges = []
   for cost, u, v in self.edges:
            directed_edges.append((u, v, cost))
            directed_edges.append((v, u, cost))
for _ in range(len(self.graph) - 1):
            changed = False
  for u, v, cost in directed_edges:
                if distances[u] != float("inf"):
                    if distances[u] + cost < distances[v]:
                        distances[v] = distances[u] + cost
                        changed = True
if not changed:
                break
 for u, v, cost in directed_edges:
            if distances[u] != float("inf"):
                if distances[u] + cost < distances[v]:
                    return distances, False
 return distances, True
def floyd_warshall(self):
        nodes = list(self.graph)
        distances = {
            u: {
                v: (0 if u == v else float("inf"))
                for v in node    }
            for u in nodes    }
 for u in nodes:
            for v, cost in self.graph[u]:
                distances[u][v] = min(
                    distances[u][v], cost )
 for k in nodes:
            for i in nodes:
                for j in nodes:
                    if distances[i][k] != float("inf"):
                        new_distance = (
                            distances[i][k] + distances[k][j] )
                        if new_distance < distances[i][j]:
                            distances[i][j] = new_distance
return distances
def merge_sort(self, values):
        if len(values) <= 1:
            return values[:]
mid = len(values) // 2
        left = self.merge_sort(values[:mid])
        right = self.merge_sort(values[mid:])
    result = []
        i = j = 0
while i < len(left) and j < len(right):
            if left[i] <= right[j]:
                result.append(left[i])
                i += 1
            else:
                result.append(right[j])
                j += 1
  result.extend(left[i:])
        result.extend(right[j:])
   return result
 def binary_search(self, values, target):
        low = 0
        high = len(values) - 1
 while low <= high:
            mid = (low + high) // 2
 if values[mid] == target:
                return mid
            elif values[mid] < target:
                low = mid + 1
            else:
                high = mid - 1
return -1
